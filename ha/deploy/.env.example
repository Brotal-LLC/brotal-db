# Copy this file to an ignored .env beside the selected host deployment.
# Paths are relative to deploy/<host>/compose.yaml unless made absolute.
CONFIG_ROOT=./config
SECRETS_DIR=./secrets

# Build and publish these images before adopting a node into the Patroni cluster.
PATRONI_IMAGE=postgres-ha-patroni:4.1.4
PGBOUNCER_IMAGE=postgres-ha-pgbouncer:1.25.2
